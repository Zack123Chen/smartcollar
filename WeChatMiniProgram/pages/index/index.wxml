<view class="page">
  <view class="hero">
    <view class="hero-copy">
      <view class="meta-row">
        <text class="eyebrow">CareGuard Mini</text>
        <text class="status {{statusClass}}">{{statusLabel}}</text>
      </view>
      <view class="title-row">
        <text class="title">宠爱云护</text>
      </view>
    </view>
    <button class="icon-button" bindtap="connectBroker" disabled="{{connected || connecting}}">
      {{connectButtonLabel}}
    </button>
  </view>

  <view wx:if="{{alarmActive}}" class="alarm-card">
    <view class="alarm-head">
      <text>生命体征预警</text>
      <button class="quiet-button" bindtap="toggleMute">{{alarmMuteLabel}}</button>
    </view>
    <text class="alarm-text">{{alertMessage}}</text>
    <view class="alarm-metrics">
      <text>{{telemetry.temp}} °C</text>
      <text>{{telemetry.hr}} BPM</text>
    </view>
  </view>

  <view class="metric-grid">
    <view class="metric-card">
      <text class="metric-label">状态</text>
      <text class="metric-value {{alarmMetricClass}}">{{telemetry.displayState}}</text>
    </view>
    <view class="metric-card">
      <text class="metric-label">心率</text>
      <text class="metric-value">{{telemetry.hr}} BPM</text>
    </view>
    <view class="metric-card">
      <text class="metric-label">体温</text>
      <text class="metric-value {{tempMetricClass}}">{{telemetry.temp}} °C</text>
    </view>
    <view class="metric-card">
      <text class="metric-label">电量</text>
      <text class="metric-value">{{telemetry.battery}} %</text>
    </view>
  </view>

  <view class="panel">
    <view class="panel-head">
      <text>定位与数据</text>
      <text class="soft">已存 {{historyCount}} 条</text>
    </view>
    <map
      class="location-map"
      latitude="{{telemetry.lat}}"
      longitude="{{telemetry.lng}}"
      markers="{{mapMarkers}}"
      scale="16"
    />
    <view class="coord-row">
      <text>GPS</text>
      <text>{{telemetry.lng}}, {{telemetry.lat}}</text>
    </view>
    <view class="coord-row">
      <text>来源</text>
      <text>{{telemetry.source}}</text>
    </view>
    <view class="coord-row">
      <text>更新</text>
      <text>{{lastUpdated}}</text>
    </view>
  </view>

  <view class="panel">
    <view class="panel-head">
      <text>远程控制</text>
      <text class="soft">同步 Web 前端</text>
    </view>
    <view class="control-list">
      <button wx:for="{{controls}}" wx:key="code" class="control-button" data-code="{{item.code}}" data-desc="{{item.desc}}" bindtap="sendCommand">
        <text>{{item.label}}</text>
        <text>{{item.desc}}</text>
      </button>
    </view>
  </view>

  <view class="panel">
    <view class="panel-head">
      <text>事件日志</text>
      <text class="soft">最近 6 条</text>
    </view>
    <view class="log-list">
      <view wx:for="{{logs}}" wx:key="id" class="log-row">
        <text class="log-time">{{item.time}}</text>
        <text class="log-type">{{item.type}}</text>
        <text class="log-text">{{item.text}}</text>
      </view>
    </view>
  </view>
</view>
