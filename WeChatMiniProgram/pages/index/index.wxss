.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f6f6f4;
}

.hero,
.panel,
.metric-card,
.alarm-card {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid #e4e1dc;
  border-radius: 16rpx;
  box-shadow: 0 16rpx 44rpx rgba(31, 35, 40, 0.06);
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 30rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.eyebrow,
.soft,
.metric-label,
.log-time {
  color: #6b6f76;
  font-size: 22rpx;
}

.title-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.title {
  color: #1f2328;
  font-size: 38rpx;
  font-weight: 700;
  white-space: nowrap;
}

.status {
  flex: none;
  padding: 5rpx 13rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 650;
  white-space: nowrap;
}

.status-ok {
  color: #29745f;
  background: #e0ede8;
}

.status-wait {
  color: #9a6b18;
  background: #f4ead1;
}

.icon-button,
.quiet-button,
.control-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  border-radius: 14rpx;
  font-weight: 650;
  box-sizing: border-box;
}

.icon-button::after,
.quiet-button::after,
.control-button::after {
  border: none;
}

.icon-button {
  width: 184rpx;
  min-height: 72rpx;
  color: #fff;
  background: #1f2328;
  font-size: 27rpx;
}

.alarm-card {
  margin-top: 20rpx;
  padding: 26rpx;
  color: #7a2020;
  background: #f4dddd;
  border-color: rgba(179, 66, 66, 0.3);
}

.alarm-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 700;
}

.quiet-button {
  min-height: 56rpx;
  padding: 0 18rpx;
  color: #7a2020;
  background: rgba(255, 255, 255, 0.58);
  font-size: 23rpx;
}

.alarm-text {
  display: block;
  margin-top: 14rpx;
  color: #7a2020;
  font-size: 26rpx;
  line-height: 1.55;
}

.alarm-metrics {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.alarm-metrics text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #7a2020;
  background: rgba(255, 255, 255, 0.56);
  font-size: 24rpx;
  font-weight: 700;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.metric-card {
  min-height: 116rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.metric-label {
  display: block;
}

.metric-value {
  display: block;
  margin-top: 10rpx;
  color: #1f2328;
  font-size: 31rpx;
  font-weight: 750;
  line-height: 1.12;
}

.danger {
  color: #b34242;
}

.panel {
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #1f2328;
  font-size: 28rpx;
  font-weight: 700;
}

.coord-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 16rpx;
  color: #6b6f76;
  font-size: 24rpx;
}

.coord-row text:first-child {
  color: #1f2328;
  font-weight: 650;
}

.location-map {
  display: block;
  width: 100%;
  height: 260rpx;
  margin-top: 20rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #ece9e2;
}

.control-list {
  display: grid;
  gap: 10rpx;
  margin-top: 18rpx;
  width: 100%;
  overflow: hidden;
}

.control-button {
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  padding: 14rpx 18rpx;
  align-items: flex-start;
  flex-direction: column;
  color: #1f2328;
  background: #faf9f7;
  border: 1rpx solid #e4e1dc;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: left;
}

.control-button text:first-child {
  font-weight: 700;
}

.control-button text:last-child {
  display: block;
  margin-top: 6rpx;
  color: #6b6f76;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.35;
}

.log-list {
  display: grid;
  gap: 10rpx;
  margin-top: 18rpx;
}

.log-row {
  display: grid;
  grid-template-columns: 88rpx 62rpx minmax(0, 1fr);
  gap: 8rpx;
  align-items: start;
  color: #6b6f76;
  font-size: 22rpx;
  line-height: 1.45;
}

.log-type {
  color: #29745f;
  font-weight: 650;
}

.log-text {
  word-break: break-all;
}
